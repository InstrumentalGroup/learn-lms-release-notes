+{% require_js %}
+<script>
+  // Livid videos speak the Player.js protocol (https://github.com/embedly/player.js).
+  // window.lividPlayers is polled by module.js's video tracker, same as ytPlayers.
+  window.lividPlayers = [];
+
+  (function () {
+    function attach(iframe) {
+      var player = new playerjs.Player(iframe);
+      var entry = { player: player, iframe: iframe, ready: false, playing: false, ended: false, duration: 0 };
+      window.lividPlayers.push(entry);
+
+      function markCompleted() {
+        var lesson = iframe.closest('.tab_content');
+        var input = lesson && lesson.querySelector('.video-status');
+        if (input) input.value = 'completed';
+      }
+
+      player.on('ready', function () {
+        entry.ready = true;
+        player.getDuration(function (d) { if (d > 0) entry.duration = d; });
+      });
+      player.on('play', function () { entry.playing = true; entry.ended = false; });
+      player.on('pause', function () { entry.playing = false; });
+      player.on('ended', function () { entry.playing = false; entry.ended = true; markCompleted(); });
+      player.on('timeupdate', function (data) {
+        if (data && data.duration > 0) entry.duration = data.duration;
+      });
+    }
+
+    function init() {
+      document.querySelectorAll('iframe.livid-player').forEach(attach);
+    }
+
+    if (!document.querySelector('iframe.livid-player')) return;
+    var s = document.createElement('script');
+    s.src = 'https://cdn.embed.ly/player-0.1.0.min.js';
+    s.onload = init;
+    document.head.appendChild(s);
+  })();
+</script>
+{% end_require_js %}
+
